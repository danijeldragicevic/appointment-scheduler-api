# Copy this file to dev.env and adjust values as needed.

PORT=8080
API_TOKEN=changeme

# Alternate bearer token. Grants identical API access to API_TOKEN, but is
# classified as the "agent" rate-limit tier (see Rate limiting in README.md)
# instead of the default tier. Used by the MCP server (npm run mcp).
AGENT_API_TOKEN=changeme-agent

# Only used by the MCP server (npm run mcp) to reach the running API.
# Defaults to http://localhost:${PORT} if unset.
# API_BASE_URL=http://localhost:8080
